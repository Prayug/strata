# ---- Strata configuration (copy to .env) ------------------------------------
# Where Parquet market data, the SQLite database, results and caches live.
STRATA_DATA_DIR=./data
# Worker processes for optimisation studies (default: CPU count - 1).
STRATA_MAX_WORKERS=
# Background jobs (backtests/studies/ingestion) allowed to run at once.
STRATA_MAX_JOBS=2
# Rate used only when computing IV/Greeks from observed quotes that lack them.
STRATA_RISK_FREE_RATE=0.04
# Comma-separated origins allowed to call the API from a browser (Vite dev server).
STRATA_CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# ---- AI Strategy Lab (optional) ----------------------------------------------
# Without any key the lab uses the built-in offline interpreter. Keys can also be entered
# under Settings in the app; they stay on the server and are never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Free data (optional key) -------------------------------------------------
# Yahoo, CBOE, DoltHub and the open EOD option archive need no key.
# Alpaca's free plan adds 1-minute stock bars since 2016 and option trade bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ---- Paid data providers (only configure what you subscribe to; never called automatically)
# ThetaData: run the Theta Terminal locally; it exposes a REST API on this port.
THETADATA_BASE_URL=http://127.0.0.1:25510
# Polygon.io / Massive: historical option quotes need the Options Advanced plan.
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
# Databento: OPRA.PILLAR (cbbo-1m, definition) + DBEQ.BASIC (ohlcv-1m). pip install 'strata[databento]'
DATABENTO_API_KEY=
# ORATS Data API (end-of-day strikes with ORATS IV/Greeks).
ORATS_API_KEY=
ORATS_BASE_URL=https://api.orats.io/datav2
